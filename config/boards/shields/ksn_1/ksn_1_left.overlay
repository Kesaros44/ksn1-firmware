#include "ksn_1.dtsi"
#include <dt-bindings/zmk/hid_indicators.h>

/* caps_lock_led: ZMK 코어 공식 LED Indicators 기능 사용 (커스텀 드라이버 불필요).
   CONFIG_ZMK_SPLIT_PERIPHERAL_HID_INDICATORS=y 로 central(오른쪽)의 caps lock
   상태가 peripheral(왼쪽)까지 동기화되며, zmk,indicator-leds 노드가 이 GPIO를
   직접 구동한다. (참고: https://zmk.dev/docs/hardware-integration/lighting/led-indicators)

   status_led: zmk-poor-mans-led-indicator 모듈(west.yml에 이미 임포트됨) 사용.
   indicator-led alias로 지정하고 .conf에서 CONFIG_INDICATOR_LED_WIDGET=y,
   CONFIG_INDICATOR_LED_SHOW_PERIPHERAL_CONNECTED=y 를 켜면, 왼쪽이 central(오른쪽)에
   붙어있는지(블루투스 연결 상태)를 이 LED로 표시한다. */
/ {
    leds {
        compatible = "gpio-leds";
        caps_lock_led: caps_lock_led {
            gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;  /* P0.02 - D19 */
        };
        status_led: led_1 {
            gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;  /* P0.29 - D20 */
            label = "BLE Status LED";
        };
    };

    indicators {
        compatible = "zmk,indicator-leds";
        caps_lock_indicator: caps_lock {
            indicator = <HID_INDICATOR_CAPS_LOCK>;
            leds = <&caps_lock_led>;
        };
    };

    aliases {
        caps-lock-led = &caps_lock_led;
        status-led = &status_led;
        indicator-led = &status_led;
    };
};
